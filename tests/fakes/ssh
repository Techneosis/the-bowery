#!/usr/bin/env bash
# A stand-in for ssh: runs the remote command on this machine, in a fake box.
#
# FAKE_SSH_HOSTS is a list of "<host>=<home>" words: the box's $HOME for each
# host it knows. Any other host fails as ssh does, with exit 255. Every call
# is logged to $FAKE_HERDR_DIR/ssh.log, one line per call, and its -o options
# to ssh-opts.log, one call per line.
host=""
opts=""
while (($#)); do
  case $1 in
    -o) opts+="$2 "; shift 2 ;;
    -*) shift ;;
    *) host=$1; shift; break ;;
  esac
done
printf '%s\t%s\n' "$host" "$*" >>"$FAKE_HERDR_DIR/ssh.log"
printf '%s\n' "$opts" >>"$FAKE_HERDR_DIR/ssh-opts.log"
# FAKE_SSH_FAIL_ON: a call whose command holds this text fails as a dropped
# connection does (exit 255), so one call can fail while the rest work.
if [[ -n $FAKE_SSH_FAIL_ON && $* == *"$FAKE_SSH_FAIL_ON"* ]]; then
  echo "Connection to $host closed by remote host." >&2
  exit 255
fi
for pair in $FAKE_SSH_HOSTS; do
  if [[ ${pair%%=*} == "$host" ]]; then
    export HOME=${pair#*=}
    cd "$HOME" || exit 255
    exec bash -c "$*"
  fi
done
echo "ssh: Could not resolve hostname $host: Name or service not known" >&2
exit 255
